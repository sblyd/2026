#!name=自定义 DNS Host 分流
#!desc=按域名指定 DNS；仅调整 Host，适用于 Surge iOS 5.21.0 及以上

[Host]
# 合并重复域名；同一行多个普通 DNS 并非主备顺序。
# 香港运营商 DNS 可能仅对本网络开放；如有超时，可自行改用其他 DNS。
# 原配置中与香港运营商 DNS 重复的 Cloudflare DoH 未同时启用。
# 切换到 Cloudflare DoH：将对应行的 DNS 改为 https://1.1.1.1/dns-query。
# *.example.com 不匹配 example.com；下方给常规域名补齐了根域名。


# ========================================
# 局域网与 IPv6
# ========================================
*.lan = server:system
*.local = server:system
*.home.arpa = server:system
ip6-localhost = ::1
ip6-loopback = ::1
ip6-localnet = fe00::0
ip6-mcastprefix = ff00::0
ip6-allnodes = ff02::1
ip6-allrouters = ff02::2
ip6-allhosts = ff02::3

# ========================================
# Google 推送：停用未经验证的固定 IP
# ========================================
# 交由后面的 *.google.com 规则或代理服务器解析。
# 谷歌推送 IP 会变化，以下保留原值供参考，不建议启用。
# talk.google.com = 108.177.125.188
# mtalk.google.com = 108.177.125.188
# alt1-mtalk.google.com = 3.3.3.3
# alt2-mtalk.google.com = 3.3.3.3
# alt3-mtalk.google.com = 74.125.200.188
# alt4-mtalk.google.com = 74.125.200.188
# alt5-mtalk.google.com = 3.3.3.3
# alt6-mtalk.google.com = 3.3.3.3
# alt7-mtalk.google.com = 74.125.200.188
# alt8-mtalk.google.com = 3.3.3.3
# services.googleapis.cn = 74.125.193.94
# dl.google.com = 180.163.151.161
# dl.l.google.com = 180.163.151.161

# ========================================
# Google 指定服务 / STUN
# ========================================
blog.google = server:180.184.1.1
googletraveladservices.com = server:180.184.1.1
dl.google.com = server:180.184.1.1
dl.l.google.com = server:180.184.1.1
clientservices.googleapis.com = server:180.184.1.1
update.googleapis.com = server:180.184.2.2
translate.googleapis.com = server:180.184.1.1
fonts.googleapis.com = server:180.184.1.1
fonts.gstatic.com = server:180.184.1.1
stun.l.google.com = server:system
stun?.l.google.com = server:system

